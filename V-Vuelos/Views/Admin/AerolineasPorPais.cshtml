@model List<V_Vuelos.Models.Aerolineas_Pais>
@{
    Layout = "~/Views/Shared/_Layout_admin.cshtml";
    ViewBag.Title = "Aerolineas Por Pais";
}

<h2>Aerolineas Por Pais</h2>

<h2>Lista de Agencias</h2>

<label for="filtroPais">Filtrar por país:</label>
<select id="filtroPais">
    <option value="">Selecciona un país</option>
    @foreach (var pais in Model.Select(ap => ap.Pai).Distinct())
    {
        <option value="@pais.NombrePais">@pais.NombrePais</option>
    }
</select>

<table id="tablaAgencias" border="1" class="table table-striped">
    <tbody id="cuerpoTabla">
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>País</th>
            <th>Imagen</th>
        </tr>

    <tbody id="cuerpoTabla">
        @foreach (var aerolinea in Model)
        {
            <tr>
                <td>@aerolinea.CodigoAgencia</td>
                <td>@aerolinea.Aerolinea.NombreAgencia</td>
                <td>@aerolinea.Pai.NombrePais</td>
                <td><img src="data:image;base64,@aerolinea.Aerolinea.Imagen" width="100" </td> <!-- Aquí deberías mostrar la imagen si tienes la URL -->
            </tr>
        }
    </tbody>
    
</table>

<script>
    document.getElementById("filtroPais").addEventListener("change", function () {
        var selectedPais = this.value.toUpperCase();
        var table = document.getElementById("tablaAgencias");
        var tr = table.getElementsByTagName("tr");

        for (var i = 1; i < tr.length; i++) {
            var tdPais = tr[i].getElementsByTagName("td")[2];
            if (tdPais) {
                var paisText = tdPais.textContent || tdPais.innerText;
                if (selectedPais === "" || paisText.toUpperCase() === selectedPais) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    });</script>
