
@{
    Layout = "~/Views/Shared/_Layout_admin.cshtml";

    ViewBag.Title = "Cambiar Contraseña";
}

<h2>Cambiar Contraseña</h2>
<div style="text-align:center">
    <form>

        <div class="row" style="padding: 4px">
            <div class="col" style="text-align:right; padding:1px">

                <label for="password">Contraeña:</label><br />
                <label for="passwordChang">Nueva Contraseña:</label><br />
                <label for="passwordConf">Confirmar Contraseña:</label>

            </div>
            <div class="col" style="text-align:left" ; padding:1px>
                <input type="password" id="password" name="password" required><br />
                <input type="password" id="passwordChang" name="passwordChang" required><br />
                <input type="password" id="passwordConf" name="passwordConf" required>
            </div>
            <div class="row" style="display: flex; justify-content: center;">
                <div class="col-2">
                    <button class="btn btn-primary">Cambiar Contraseña</button>
                </div>
                <div class="col-2">
                    <button class="btn btn-dark">Cancelar</button>
                </div>
            </div>
    </form>
</div>
