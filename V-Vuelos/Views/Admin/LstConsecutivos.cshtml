
@{
    Layout = "~/Views/Shared/_Layout_admin.cshtml";

    ViewBag.Title = "LstConsecutivos"; 
}

<h2>Lista de Consecutivos</h2>

<table class="table table-striped">
    <tr>
        <th>Código</th>
        <th>Descripción</th>
        <th>Consecutivo</th>
        <th>Editar</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Prefijo</td>
            <td>@item.Descripcion</td>
            <td>@item.Consecutivo1</td>
            <td><a href="@Url.Action("EditConsecutivo", "Admin", new { id = item.Codigo })">Editar</a></td>
        </tr>
    }

</table>