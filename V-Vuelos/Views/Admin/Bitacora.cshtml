@model List<V_Vuelos.Models.Vitacora>
@{
    Layout = "~/Views/Shared/_Layout_admin.cshtml";

    ViewBag.Title = "Bitacora";
}

<h2>Bitacora</h2>

<div class="col" style="text-align:center; padding:5px">
    <div class="search-bar">
        <input type="text" placeholder="Buscar usuario...">
    </div>
    <div class="search-bar">
        <input type="text" placeholder="Buscar fecha...">
    </div>
    <div class="search-bar">
        <input type="text" placeholder="Buscar tipo...">
    </div>
    <button>Filtrar</button>
    <br />
    <div style="overflow-x:auto;">
        <table class="table table-striped; text-align:center">
            <tr>
                <th>ID</th>
                <th>Usuario</th>
                <th>Fecha y hora</th>
                <th>Código del registro</th>
                <th>Tipo</th>
                <th>Descripción</th>
                <th>Registro en detalle</th>
            </tr>
            @foreach (var vitacora in Model)
            {
                <tr class="errorRow">
                    <td>@vitacora.Id</td>
                    <td>@vitacora.NombreUsuario</td>
                    <td>@vitacora.Fecha_Hora</td>
                    <td>@vitacora.CodigoRegistro</td>
                    <td>@vitacora.Tipo</td>
                    <td>@vitacora.Descripcion</td>
                    <td>@(vitacora.Detalle.Length > 50 ? vitacora.Detalle.Substring(0, 50) + "..." : vitacora.Detalle)</td>
                </tr>
            }
        </table>
    </div>
    </div>
