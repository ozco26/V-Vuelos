
@{
    Layout = "~/Views/Shared/_Layout_admin.cshtml";

    ViewBag.Title = "Bitacora";
}

<h2>Bitacora</h2>

<div class="col" style="text-align:center; padding:5px">
    <div class="search-bar">
        <input type="text" placeholder="Buscar usuario...">
    </div>
    <div class="search-bar">
        <input type="text" placeholder="Buscar fecha...">
    </div>
    <div class="search-bar">
        <input type="text" placeholder="Buscar tipo...">
    </div>
    <button>Filtrar</button>
    <br />
    <table class="table table-striped; text-align:center">
