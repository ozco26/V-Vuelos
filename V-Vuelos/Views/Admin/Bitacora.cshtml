        </tr>
        <tr>
            <td>Fulanito</td>
            <td>04/04/2024 11:20:33 a.m.</td>
            <td>AE-01</td>
            <td>Eliminar</td>
            <td>Se elimina el registro AE-01</td>
            <td>Codigo=AE-01|Nombre:Fulanito</td>

        </tr>
    </table>
