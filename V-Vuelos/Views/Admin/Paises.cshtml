@{
    Layout = "~/Views/Shared/_Layout_admin.cshtml";
    ViewBag.Title = "Paises";
}

<h2>Paises</h2>

<div class="row" style="padding: 4px">
    <div class="col" style="text-align:center; padding:5px">
        <table class="table table-striped">
            <tr>
                <th>Código del país</th>
                <th>Nombre del país</th>
                <th>Imagen</th>
                <th></th>
            </tr>
            @foreach (var pais in ViewBag.Paises)
            {
                <tr>
                    <td>@pais.CodigoPais</td>
                    <td>@pais.NombrePais</td>
                    <td><img src="data:image;base64,@pais.Imagen" width="100" /></td>
                </tr>
            }
        </table>
    </div>
    <div class="col" style="text-align:left; padding:1px">
        <h3>Crear nuevos Países</h3>
        <form enctype="multipart/form-data" method="post" action="GuardarImagen">
            <p>Código</p>
            <input id="codigoPais" name="codigoPais" type="text"> <br />
            <p>Nombre del País</p>
            <input id="nombrePais" name="nombrePais" type="text"><br /><br />
            <p>Imagen</p>
            <input type="file" name="imagen" accept="image/*"><br /><br />
            <button type="submit">Guardar</button>
            <button type="reset">Limpiar</button><br />
        </form>
    </div>
</div>
