@{
    Layout = "~/Views/Shared/_Layout_admin.cshtml";
    ViewBag.Title = "Paises";
}

<h2>Paises</h2>

<script>
    function Limpiar() {
        document.getElementById("nombrePais").value = ""; 
        document.getElementById("imagen").value = null; 
    }

    async function leerArchivoComoBase64(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => {
                resolve(reader.result.split(',')[1]);
            };
            reader.onerror = reject;
            reader.readAsDataURL(file);
        });
    }

    async function GuardarPais() {
        try {
            const codPais = document.getElementById("codigoPais").value.trim();
            const nombre = document.getElementById("nombrePais").value.trim();
            const imagen = document.getElementById("imagen");

            if (imagen.files.length > 0) {
                const file = imagen.files[0];
                const String64 = await leerArchivoComoBase64(file);
                console.log('Base 64 Imagen: ' + String64);

                const PaisCuerpo = {
                    CodigoPais: codPais,
                    NombrePais: nombre,
                    Imagen: String64
                };

                console.log(PaisCuerpo);

                const response = await fetch("http://localhost:5056/api/Values/GuardarPaises", {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(PaisCuerpo)
                });

                const data = await response.json();
                console.log(data.success + ', ' + data.message);
                if (data.success) {
                    alert(data.message);
                } else {
                    alert('Error: ' + data.message)
                }
            } else {
                console.log('No se pudo guardar la imagen');
            }
        } catch (err) {
            console.error('Error:' + err);
            alert('Error al registrar país');
        }
    }

    function ObtenerPrefijoPais() {
        var ultimoPrefijo = '@ViewBag.UltimoPrefijoPais';
        var numeroConsecutivo = parseInt('@ViewBag.NumeroConsecutivo') + 1;

        var devolver = ultimoPrefijo + '-' + numeroConsecutivo;

        console.log(ultimoPrefijo+'-'+numeroConsecutivo)

        return devolver;
    };

    window.onload = function () {
        document.getElementById("codigoPais").value = ObtenerPrefijoPais();
    };

</script>

<div class="row" style="padding: 4px">
    <div class="col" style="text-align:center; padding:5px">
        <table class="table table-striped">
            <tr>
                <th>Código del país</th>
                <th>Nombre del país</th>
                <th>Imagen</th>
                <th></th>
            </tr>
            @foreach (var pais in ViewBag.paises)
            {
                <tr>
                    <td>@pais.CodigoPais</td>
                    <td>@pais.NombrePais</td>
                    <td><img src="data:image;base64,@pais.Imagen" width="100" /></td>
                </tr>
            }
        </table>
    </div>
    <div class="col" style="text-align:left; padding:1px">
        <h3>Registrar Pais</h3>
        <form>
            <table style="border-collapse: collapse;">
                <tr>
                    <td><p>Código:</p></td>
                    <td><input id="codigoPais" name="codigoPais" type="text" readonly value=""></td>
                </tr>
                <tr>
                    <td><p>Nombre del País:</p></td>
                    <td><input id="nombrePais" name="nombrePais" type="text"></td>
                </tr>
                <tr>
                    <td><p>Imagen:</p></td>
                    <td><input type="file" id="imagen" name="imagen" accept="image/*"></td>
                </tr>
                <tr>
                    <td colspan="2">
                        <button type="button" onclick="GuardarPais()">Guardar</button>
                        <button type="button" onclick="Limpiar()">Borrar</button>
                    </td>
                </tr>
            </table>
        </form>
    </div>
</div>





