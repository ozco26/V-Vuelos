@using V_Vuelos.Models

@{
    // Obtener una instancia de UrlHelper
    UrlHelper urlHelper = new UrlHelper(Request.RequestContext);

    // Generar la ruta de la página actual
    string currentPageUrl = urlHelper.Action(ViewContext.RouteData.Values["action"].ToString(),
                                             ViewContext.RouteData.Values["controller"].ToString()).Replace("/",">");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - V-Vuelos</title>
