                    <div class="container-fluid">
                        <img width="731" src="~/Images/Airplane Wallpaper.jpg" height="325" />
                    </div>
                </td>
                <td width="32%">
                    <p>
                        Bienvenido:
                    </p>
                    <p>
                        @((Session["User"] as Usuario)?.Nombre_Usuario)
                    </p>
                    <form action="@Url.Action("LogOut", "Admin")" method="post">
                        <button type="submit" class="btn btn-secondary">
                            Cerrar Sesión
                        </button>
                    </form>
                </td>
            </tr>
        </table>

    </header>
