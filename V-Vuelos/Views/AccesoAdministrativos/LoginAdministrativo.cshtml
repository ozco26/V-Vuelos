
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>LoginAdministrativo</title>
    @*<script src="https://www.google.com/recaptcha/api.js" async defer></script>*@
    <link rel="stylesheet" href="~/Content/LoginStyle.css" />
</head>
<body>

    <form action=@Url.Content("~/AccesoAdministrativos/Login") method="post">
        <h2>Iniciar Sesión Administrador del sistema </h2>
        <label for="username">Usuario:</label>
        <input type="text" id="username" name="username" required>
        <label for="password">Contraseña:</label>
        <input type="password" id="password" name="password" required>
        <br />
        <div class="g-recaptcha" data-sitekey="TU_CLAVE_DE_SITIO"></div>
        <br />
        <input type="submit" value="Iniciar Sesión">
    </form>
</body>
</html>
