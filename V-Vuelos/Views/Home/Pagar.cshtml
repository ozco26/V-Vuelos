@{
    if (Session["User"] == null)
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout_login.cshtml";
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Pagar</title>
    <script>
        // Redirigir después de 5 segundos (5000 ms)
        setTimeout(function () {
            window.location.href = '/Home/Index'; // Reemplaza con la ruta a la que quieres redirigir
        }, 5000);
    </script>
</head>
<body>
    <h1>Gracias por comprar</h1>
    <p>Será redirigido a la página principal en unos segundos...</p>
</body>
</html>
