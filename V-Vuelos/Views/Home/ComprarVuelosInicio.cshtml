
@{
    
    Layout = Layout = "~/Views/Shared/_Layout.cshtml";
    if (Session["User"] == null)
    {
        Layout = "~/Views/Shared/_Layout.cshtml";

    }
    else
    {

        Layout = "~/Views/Shared/_Layout_login.cshtml";
    }
}
@using V_Vuelos.Models

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>ComprarVuelosInicio</title>
</head>
<body>
    <div>
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <div class="text-center">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Madrid</h5>
                                <p class="card-text">Aerolínea: Iberia</p>
                                <p class="card-text">Fecha: 2024-02-11</p>
                                <p class="card-text">Hora: 09:30</p>
                                <p class="card-text">Precio: 500 US</p>
                                <button onclick="disminuir('numero1')">-</button>
                                <input type="number" id="numero1" value="0" min="0">
                                <button onclick="incrementar('numero1')">+</button><br>
                                <a href="@Url.Action("MetodoPago", "Home", new { id = (Session["User"] as Usuario)?.Id_Usuario })">Comprar</a>

                            </div>
                        </div>
                        <br>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <script>
        function incrementar(id) {
            var input = document.getElementById(id);
            input.value = parseInt(input.value) + 1;
        }

        function disminuir(id) {
            var input = document.getElementById(id);
            if (parseInt(input.value) > 0) {
                input.value = parseInt(input.value) - 1;
            }
        }


    </script>
</body>
</html>
