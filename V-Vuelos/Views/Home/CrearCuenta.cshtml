
@{
    if (Session["User"] == null)
    {
        Layout = "~/Views/Shared/_Layout.cshtml";

    }
    else
    {
        Layout = "~/Views/Shared/_Layout_login.cshtml";
    }
}

<!DOCTYPE html>

<html>
<head>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>

    <meta name="viewport" content="width=device-width" />
    <title>CrearCuenta</title>

</head>
<body>
    <div class="row align-items-center" style="padding: 4px">
        <div class="col" style="padding:1px">
            <div class="container">

                @if (ViewData.ModelState.Any())
                {
                    <div class="alert alert-danger">
                        <ul>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }
                <div class="row align-items-center" style="padding: 4px">
                    <div class="col" style="padding:1px">
                        <div class="container">
                            <form id="miFormulario" action="/Home/CrearCuenta" method="post">
                                <h1>Crear Cuenta</h1>

                                <label for="nombre">Nombre:</label>
                                <input type="text" id="nombre" name="nombre" required>

                                <label for="apellido1">Primer Apellido:</label>
                                <input type="text" id="apellido1" name="apellido1" required>

                                <label for="apellido2">Segundo Apellido:</label>
                                <input type="text" id="apellido2" name="apellido2" required>

                                <label for="correo">Correo Electrónico:</label>
                                <input style="width: 100%; padding: 10px" margin-bottom: 20px; border: 1px solid #ccc; border-radius: 5px; box-sizing: border-box;" type="email" id="correo" name="correo" required>

                                <label for="usuario">Nombre de Usuario:</label>
                                <input type="text" id="usuario" name="usuario" onblur="verificarUsuario()" required>

                                <div id="resultadoUsuario">

                                    <label id="lblinptVerificarUsuario" for="inptVerificarUsuario" style="display:none">El usuario indicado ya fue ocupado por otro usuario, por favor pruebe con los siguientes:</label>
                                    <input type="text" value="" disabled style="display:none" id="inptVerificarUsuario" name="inptVerificarUsuario" />
                                    <label id="UsuarioDisponible" style="display:none; color: green">Usuario Disponible</label>
                                </div>

                                <label for="contrasena">Contraseña:</label>
                                <input style="width: 100%; padding: 10px" margin-bottom: 20px; border: 1px solid #ccc; border-radius: 5px; box-sizing: border-box;" type="password" id="contrasena" name="contrasena" required>
                                <br />

                                <label for="confirmar">Confirmar Contraseña:</label>
                                <input style="width: 100%; padding: 10px" margin-bottom: 20px; border: 1px solid #ccc; border-radius: 5px; box-sizing: border-box;" type="password" id="confirmar" name="confirmar">
                                <br />
                                <br />

                                <div class="g-recaptcha" data-sitekey="6LdBZr4pAAAAANbM1WLR2EjYtdsjewY_NjAjkF63" data-callback="onCaptchaResolved"></div>
                                <input type="hidden" id="captchaResponse" name="captchaResponse" value="" />
                                <br />

                                <button class="btn btn-primary" type="submit" style="display:none" id="btnCrearCuenta">Crear Cuenta</button>
                            </form>
                        </div>
                    </div>
                    <div class="col" style="padding:1px ; text-align:center">
                        <div class="botones">
                            <button class="btn btn-danger boton-google" onclick="iniciarSesionGoogle()">Registrarse con Google</button><br /><br />
                            <button class="btn btn-primary boton-facebook" onclick="iniciarSesionFacebook()">Registrarse con Facebook</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>




        async function verificarUsuario() {
            try {
                var username = document.getElementById("usuario").value.trim();

                // Verificar si el nombre de usuario está vacío
                if (username === "") {
                    return alert("Por favor ingrese un nombre de usuario");
                }

                // Obtener los valores de name, apellido1 y apellido2
                name1 = document.getElementById("nombre").value.trim();
                apellido1 = document.getElementById("apellido1").value.trim();
                apellido2 = document.getElementById("apellido2").value.trim();

                // Verificar si algún otro campo está vacío
                if (username === "" || name1 === "" || apellido1 === "" || apellido2 === "") {
                    return alert("Todos los campos deben estar llenos");
                }

                // Hacer la solicitud al servidor para verificar la disponibilidad del nombre de usuario
                const response = await fetch(`http://localhost:5056/api/Values/VerificarUsuario/${username}`, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                const data = await response.json();

                // Verificar la respuesta del servidor
                if (data.disponible) {
                    alert("El nombre de usuario está disponible");
                    document.getElementById("btnCrearCuenta").style.display = "block";
                    document.getElementById("UsuarioDisponible").style.display = "block";
                    document.getElementById("lblinptVerificarUsuario").style.display = "none";
                    document.getElementById("inptVerificarUsuario").style.display = "none";
                } else {
                    alert("El nombre de usuario ya está en uso");
                    var random1 = Math.floor(Math.random() * 100).toString();
                    var random2 = Math.floor(Math.random() * 100).toString();

                    var inputValue = random1 + name1 + apellido2 + "  //  " +
                        apellido1 + random2 + name1 + "  //  " +
                        apellido1 + name1 + random1;
                    document.getElementById("inptVerificarUsuario").style.display = "block";
                    document.getElementById("inptVerificarUsuario").value = inputValue;
                    document.getElementById("lblinptVerificarUsuario").style.display = "block";
                    document.getElementById("UsuarioDisponible").style.display = "none";
                    document.getElementById("btnCrearCuenta").style.display = "none";
                }
            } catch (error) {
                console.error('Error:' + error);
                alert('Error al verificar el nombre de usuario');
            }
        }
        function onCaptchaResolved(token) {
            document.getElementById("captchaResponse").value = token;
        }
    </script>
</body>
</html>
