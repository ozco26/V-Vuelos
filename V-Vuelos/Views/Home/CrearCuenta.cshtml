
@{
    if (Session["User"] == null)
    {
        Layout = "~/Views/Shared/_Layout.cshtml";

    }
    else
    {
        Layout = "~/Views/Shared/_Layout_login.cshtml";
    }
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>CrearCuenta</title>
</head>
<body>
    <div class="row align-items-center" style="padding: 4px">
        <div class="col" style="padding:1px">
            <div class="container">
                <h1>Crear Cuenta</h1>
                <form action="crear_cuenta.php" method="post">
                    <label for="nombre">Nombre:</label>
                    <input type="text" id="nombre" name="nombre" required>

                    <label for="apellido1">Primer Apellido:</label>
                    <input type="text" id="apellido1" name="apellido1" required>

                    <label for="apellido2">Segundo Apellido:</label>
                    <input type="text" id="apellido2" name="apellido2" required>

                    <label for="correo">Correo Electrónico:</label>
                    <input type="email" id="correo" name="correo" required>

                    <label for="usuario">Nombre de Usuario:</label>
                    <input type="text" id="usuario" name="usuario" required>
                    <button type="button" onclick="verificarUsuario()">Verificar Disponibilidad</button>
                    <div id="resultadoUsuario"></div>

                    <label for="contrasena">Contraseña:</label>
                    <input type="password" id="contrasena" name="contrasena" required>

                    <label for="confirmar">Confirmar Contraseña:</label>
                    <input type="password" id="confirmar" name="confirmar" required>


                    <div class="g-recaptcha" data-sitekey="TU_CLAVE_DE_SITIO"></div>
                    <br />

                    <button type="submit">Crear Cuenta</button>
                </form>
            </div>
        </div>
        <div class="col" style="padding:1px">
            <div class="botones">
                <button class="boton-google" onclick="iniciarSesionGoogle()">Registrarse con Google</button><br /><br />
                <button class="boton-facebook" onclick="iniciarSesionFacebook()">Registrarse con Facebook</button>
            </div>
        </div>
    </div>

</body>
</html>
