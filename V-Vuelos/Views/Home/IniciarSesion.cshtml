
@{
    if (Session["User"] == null)
    {
        Layout = "~/Views/Shared/_Layout.cshtml";

    }
    else
    {
        Layout = "~/Views/Shared/_Layout_login.cshtml";
    }
}

<!DOCTYPE html>

<html>
<head>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <meta name="viewport" content="width=device-width" />
    <title>IniciarSesion</title>

</head>
<body>
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                @if (ViewData.ModelState.Any())
                {
                    <div class="alert alert-danger">
                        <ul>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }
                <h1>Iniciar Sesión</h1>
                <form action="@Url.Action("LoginCliente", "Home")" method="post">
                    <label for="username">Usuario:</label>
                    <input type="text" id="username" name="username" required>

                    <label for="contrasena">Contraseña:</label>
                    <input style="width: 100%; padding: 10px" margin-bottom: 20px; border: 1px solid #ccc; border-radius: 5px; box-sizing: border-box;"
                           type="password" id="contrasena" name="contrasena" required><br><br>
                    <div class="g-recaptcha" data-sitekey="6LdBZr4pAAAAANbM1WLR2EjYtdsjewY_NjAjkF63" data-callback="onCaptchaResolved"></div>
        <input type="hidden" id="captchaResponse" name="captchaResponse" value="" />
                    <button type="submit">Iniciar Sesión</button> <br>
                </form>


            </div>
            @*<div class="col-md-6">
                <div class="text-center">
                    <h2>Iniciar Sesión con</h2>
                    <button class="btn btn-danger boton-social boton-google" onclick="iniciarSesionGoogle()">Google</button><br><br>
                    <button class="btn btn-primary boton-social boton-facebook" onclick="iniciarSesionFacebook()">Facebook</button>
                </div>
            </div>*@
        </div>
    </div>
    <script>
        function onCaptchaResolved(token) {
            document.getElementById("captchaResponse").value = token;
        }
    </script>
</body>
</html>
