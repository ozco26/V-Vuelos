@model List<V_Vuelos.Models.Vuelo1>
@{
    ViewBag.Title = "Lista de Vuelos de Llegada";
    if (Session["User"] == null)
    {
        Layout = "~/Views/Shared/_Layout.cshtml";

    }
    else
    {
        Layout = "~/Views/Shared/_Layout_login.cshtml";
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Vuelos de Llegada</title>

</head>
<body>
    <h2>Lista de vuelos de llegada hoy</h2>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Vuelo</th>
                <th>Aerolínea</th>
                <th>Procedencia</th>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Estado</th>
                <th>Puerta</th>
            </tr>
        </thead>
        <tbody>

            @{
                Random random = new Random(); 
                
            }

            @foreach (var vuelo in Model)
            {
                var ram = random.Next(0, 3);
                var ram2 = random.Next(1, 11);

                if (vuelo.Pai.NombrePais != "Costa Rica")
                {
                                       <tr>
                                           <td>@vuelo.vuelo</td>
                                           <td>@vuelo.Aerolinea1.NombreAgencia</td>
                                           <td>@vuelo.Pai.NombrePais</td>
                                           <td>@DateTime.Now.Date</td>
                                           <td>@vuelo.Hora</td>
                                           <td>
                                               @if (DateTime.Now.TimeOfDay.Subtract(TimeSpan.FromMinutes(60)) > vuelo.Hora)
                                               {
                                                   <span>Arribo</span>
                                               }
                                               else if (vuelo.Hora + TimeSpan.FromMinutes(10) > DateTime.Now.TimeOfDay)
                                               {
                                                   <span>A tiempo</span>
                                               }
                                               else if (ram < 1)
                                               {
                                                   <span>Retrazado</span>
                                               }
                                               else
                                               {
                                                   <span>Confirmado</span>
                                               }
                                           </td>
                                           <td>
                                               <span>@ram2</span>
                                           </td>
                                       </tr>
                    
                }
            }

        </tbody>
    </table>
</body>
</html>
